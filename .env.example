# PostgreSQL connection string — Railway provides this automatically when you
# add a PostgreSQL plugin to your project (Variables tab -> DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Random long secret used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Your real Anthropic API key (server-side only — never expose this in frontend code)
ANTHROPIC_API_KEY=sk-ant-replace-with-your-real-key

# Comma-separated list of origins allowed to call this API (your deployed site's URL)
ALLOWED_ORIGINS=https://your-site.netlify.app,http://localhost:8080

# Port the server listens on (Railway sets this automatically, this is the local fallback)
PORT=3000
